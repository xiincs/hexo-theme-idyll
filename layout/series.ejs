<%
  const list = idyll_series_list();
  const total = list.length;
%>

<section class="wrap page-head">
  <h1 class="page-head__title"><%= page.title || __('series') %></h1>
  <p class="page-head__meta"><%= _p('series_count', total) %></p>
</section>

<section class="wrap">
  <% if (page.content) { %><div class="prose prose--intro"><%- page.content %></div><% } %>

  <% if (!total) { %>
    <p class="empty"><%= __('empty_series') %></p>
  <% } else { %>
    <ul class="rows">
      <% list.forEach(s => { %>
        <li class="rows__item">
          <a class="rows__link" href="<%- url_for(s.path) %>">
            <span class="rows__name"><%= s.name %></span>
            <span class="rows__rule" aria-hidden="true"></span>
            <span class="rows__n"><%= s.posts.length %></span>
          </a>
        </li>
      <% }); %>
    </ul>
  <% } %>
</section>
