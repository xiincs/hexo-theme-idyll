<header class="nav" id="nav">
  <div class="wrap nav__in">
    <a class="nav__brand" href="<%- url_for('/') %>">
      <span class="nav__mark" aria-hidden="true"></span>
      <span class="nav__name"><%= config.title %></span>
    </a>

    <div class="nav__right">
      <nav class="nav__links" aria-label="<%= __('nav_label') %>">
        <% for (const key in (theme.menu || {})) {
             const path = theme.menu[key];
             const on   = path === '/' ? is_current('/', true) : is_current(path); %>
          <a class="nav__link<%= on ? ' is-on' : '' %>"
             href="<%- url_for(path) %>"<%= on ? ' aria-current="page"' : '' %>><%= __('menu.' + key) %></a>
        <% } %>
      </nav>

      <% if ((theme.extras || {}).theme_toggle) { %>
        <%# 三个图标都画进同一个 svg，切换时只是换显示哪一个，不动 DOM %>
        <button class="theme" id="theme" type="button"
                data-auto="<%= __('theme_auto') %>"
                data-light="<%= __('theme_light') %>"
                data-dark="<%= __('theme_dark') %>">
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
            <g class="theme__ico theme__ico--auto">
              <circle cx="8" cy="8" r="5.6" fill="none" stroke="currentColor" stroke-width="1.4"/>
              <path d="M8 2.4a5.6 5.6 0 0 0 0 11.2z" fill="currentColor"/>
            </g>
            <g class="theme__ico theme__ico--light"
               fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
              <circle cx="8" cy="8" r="3.1"/>
              <path d="M8 1.3v1.3M8 13.4v1.3M14.7 8h-1.3M2.6 8H1.3M12.74 3.26l-.92.92M4.18 11.82l-.92.92M12.74 12.74l-.92-.92M4.18 4.18l-.92-.92"/>
            </g>
            <g class="theme__ico theme__ico--dark">
              <path d="M14 8.53A6 6 0 1 1 7.47 2 4.67 4.67 0 0 0 14 8.53z"
                    fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            </g>
          </svg>
          <%# 按钮的可访问名称就是这段文字，aria-live 让切换时读屏软件念出新状态 %>
          <span class="sr-only" id="theme-state" aria-live="polite"><%= __('theme_auto') %></span>
        </button>
      <% } %>
    </div>
  </div>
</header>
